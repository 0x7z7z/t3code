<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.axis.editingagent" ExtensionBundleVersion="0.1.0" ExtensionBundleName="Axis">
  <ExtensionList>
    <Extension Id="com.axis.editingagent.panel" Version="0.1.0"/>
    <Extension Id="com.axis.editingagent.headless" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList><Host Name="PPRO" Version="[24.0,99.9]"/></HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="11.0"/></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList><Extension Id="com.axis.editingagent.panel"><DispatchInfo>
    <Resources>
      <MainPath>./index.html</MainPath>
      <ScriptPath>./host.jsx</ScriptPath>
      <CEFCommandLine><Parameter>--enable-nodejs</Parameter></CEFCommandLine>
    </Resources>
    <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
    <UI><Type>Panel</Type><Menu>Axis</Menu><Geometry>
      <Size><Width>440</Width><Height>720</Height></Size>
      <MinSize><Width>320</Width><Height>320</Height></MinSize>
    </Geometry></UI>
  </DispatchInfo></Extension>
  <Extension Id="com.axis.editingagent.headless"><DispatchInfo>
    <Resources>
      <MainPath>./headless.html</MainPath>
      <ScriptPath>./host.jsx</ScriptPath>
      <CEFCommandLine><Parameter>--enable-nodejs</Parameter></CEFCommandLine>
    </Resources>
    <Lifecycle>
      <AutoVisible>false</AutoVisible>
      <StartOn>
        <Event>com.adobe.csxs.events.ApplicationActivate</Event>
        <Event>applicationActivate</Event>
      </StartOn>
    </Lifecycle>
    <UI><Type>Custom</Type><Geometry>
      <Size><Width>1</Width><Height>1</Height></Size>
    </Geometry></UI>
  </DispatchInfo></Extension></DispatchInfoList>
</ExtensionManifest>
